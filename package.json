{
  "name": "naturaily-storyblok",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.18.2"
  },
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency 24",
    "dev:https": "turbo run dev:https",
    "dev:docs": "pnpm --filter docs dev:docs",
    "prettier:format": "prettier --write \"**/*.{ts,tsx,md,mdx}\"",
    "eslint:format": "turbo eslint:format --",
    "prepare": "husky",
    "storyblok:setup": "pnpm --filter @natu/storyblok-setup setup",
    "storybook": "pnpm --filter @natu/storybook-ui storybook",
    "storybook:build": "pnpm --filter @natu/storybook-ui storybook:build"
  },
  "devDependencies": {
    "eslint-config-custom": "workspace:*",
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "prettier": "^3.6.1",
    "tsconfig": "workspace:*",
    "turbo": "2.5.4"
  },
  "lint-staged": {
    "apps/**/*": [
      "pnpm prettier:format",
      "pnpm eslint:format"
    ],
    "packages/**/*": [
      "pnpm prettier:format",
      "pnpm eslint:format"
    ],
    "*.json": [
      "pnpm prettier:format"
    ]
  }
}
